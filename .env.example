# SMTP credentials for the `send` command (Gmail).
# Copy this file to `.env` and fill in real values. `.env` is git-ignored — never commit secrets.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
# Gmail App Password (16 chars, requires 2-Step Verification enabled). NOT your normal password.
# Create one at https://myaccount.google.com/apppasswords
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# Display name + address shown in the From header.
SMTP_FROM=FOSS4G Hiroshima 2026 <your-account@gmail.com>
